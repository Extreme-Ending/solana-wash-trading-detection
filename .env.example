# Non-secret local FastAPI configuration
PORT=8080
SOLANA_RISK_ENVIRONMENT=development
SOLANA_RISK_CORS_ORIGINS=http://localhost:5173
SOLANA_RISK_MAX_EVENTS=100
SOLANA_RISK_MAX_REQUEST_BYTES=262144
# Firebase Admin uses Application Default Credentials; never set a service-account key here.
SOLANA_RISK_FIREBASE_PROJECT_ID=YOUR_GCP_PROJECT_ID
SOLANA_RISK_ALLOWED_UIDS=YOUR_APPROVED_FIREBASE_UID
SOLANA_RISK_CHECK_REVOKED_TOKENS=true
# Per-container-process control only; this is not a distributed Cloud Run quota.
SOLANA_RISK_RATE_LIMIT_REQUESTS=30
SOLANA_RISK_RATE_LIMIT_WINDOW_SECONDS=60
