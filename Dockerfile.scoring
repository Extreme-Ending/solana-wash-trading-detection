# syntax=docker/dockerfile:1

ARG PYTHON_IMAGE=python:3.11.14-slim-bookworm@sha256:65a93d69fa75478d554f4ad27c85c1e69fa184956261b4301ebaf6dbb0a3543d

FROM ${PYTHON_IMAGE} AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build

COPY pyproject.toml README.md ./
COPY src/ ./src/

RUN python -m pip wheel --no-cache-dir --wheel-dir /wheels ".[api,models]"
RUN python -m pip install --no-cache-dir --no-compile --no-index \
        --find-links=/wheels --prefix=/install \
        "solana-wallet-risk[api,models]==0.0.0"

FROM ${PYTHON_IMAGE} AS runtime

LABEL org.opencontainers.image.title="Solana wallet experimental anomaly API" \
      org.opencontainers.image.description="Firebase-authenticated, checksum-pinned experimental unsupervised anomaly scoring" \
      org.opencontainers.image.source="https://github.com/Extreme-Ending/solana-wash-trading-detection" \
      org.opencontainers.image.experimental-artifact-sha256="de349dd2284db122ef528c03f0c61e7ab75f92ad002489399d074f554a61ebe5"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8080 \
    SOLANA_RISK_ENVIRONMENT=production \
    SOLANA_RISK_CORS_ORIGINS=http://localhost:5173 \
    SOLANA_RISK_MAX_EVENTS=100 \
    SOLANA_RISK_MAX_REQUEST_BYTES=262144

WORKDIR /app

RUN groupadd --gid 10001 appuser \
    && useradd --uid 10001 --gid appuser --no-create-home \
        --home-dir /nonexistent --shell /usr/sbin/nologin appuser

COPY --from=builder /install/ /usr/local/
COPY --chown=10001:10001 artifacts/release/4B.1/anomaly_models.joblib \
    /app/artifacts/experimental/anomaly_models.joblib
COPY --chown=10001:10001 artifacts/release/4B.1/anomaly_models_manifest.json \
    /app/artifacts/experimental/anomaly_models_manifest.json

USER 10001:10001

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import os, urllib.request; urllib.request.urlopen(f'http://127.0.0.1:{os.environ.get(\"PORT\", \"8080\")}/healthz', timeout=3)"]

CMD ["python", "-m", "solana_risk.api.run"]
