# Non-secret build-time API location. Local development uses the Vite /api proxy.
VITE_API_BASE_URL=/api
# Firebase Web configuration contains public project identifiers, never service credentials.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_GCP_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_GCP_PROJECT_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID
